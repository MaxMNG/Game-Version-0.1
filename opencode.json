{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "godot": {
        "type": "local",
        "command": ["node", "F:/GODOT/MCP/godot-mcp/build/index.js"],
        "environment": {
          "GODOT_PATH": "F:/GODOT/Godot_v4.7.2-stable_win64.exe",
          "GODOT_MCP_ALLOWED_DIRS": "F:/GODOT/Projects"
        }
      }
    }
  },
  "instructions": ["AGENTS.md", "CodeStyle.md"],
  "watcher": {
    "ignore": ["Game/.godot/**"]
  }
}
