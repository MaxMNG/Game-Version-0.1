{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "godot": {
        "type": "local",
        "command": ["python", "-m", "godot_ai"],
        "environment": {
          "GODOT_PATH": "F:/GODOT/Godot_v4.7.2-stable_win64.exe"
        }
      }
    }
  },
  "instructions": ["AGENTS.md", "CodeStyle.md"],
  "watcher": {
    "ignore": ["Game/.godot/**"]
  }
}
