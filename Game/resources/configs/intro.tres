[gd_resource type="Resource" script_class="IntroConfig" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/intro_config.gd" id="1_intro"]
[ext_resource type="Script" path="res://scripts/resources/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_line")
speaker_id = &"mom"
text = "Launched! It's alive!"
pause_after = 0.6

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_line")
speaker_id = &"dad"
text = "Yes, seems to work."
pause_after = 0.6

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("2_line")
speaker_id = &"mom"
text = "Shall we try to tune it?"
pause_after = 0.6

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("2_line")
speaker_id = &"dad"
text = "Loading weights."
pause_after = 0.8

[resource]
script = ExtResource("1_intro")
flash_duration = 0.4
free_play_duration = 3.0
black_duration = 2.0
ball_duration = 4.0
ball_size = 24.0
ball_speed = 260.0
lines = [SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4")]
